# Copy to .env.local and fill in. Never commit real values.

# Supabase (Project Settings > API Keys and Data API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses row-level security.
SUPABASE_SERVICE_ROLE_KEY=

# Which football data provider to sync from: football_data or api_football.
FOOTBALL_PROVIDER=football_data

# football-data.org (football-data.org/client/register). Server only.
FOOTBALL_DATA_TOKEN=

# API-Football (dashboard.api-football.com). Server only. Only needed if FOOTBALL_PROVIDER=api_football.
API_FOOTBALL_KEY=
API_FOOTBALL_DAILY_LIMIT=100

# Leagues to sync: competition codes for football-data.org (PL, PD, BL1, SA, FL1)
# or league ids for API-Football (39 = Premier League).
SYNC_LEAGUE_IDS=PL
# The year the season starts: 2026 = 2026/27. Update it each summer.
SYNC_SEASON=2026
SYNC_MAX_REQUESTS_PER_RUN=80

# Any long random string. Vercel Cron sends it as a Bearer token.
CRON_SECRET=
